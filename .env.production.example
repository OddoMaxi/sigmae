# ─── Fichier de substitution docker-compose (racine du repo) ─────────────────
# À copier en `.env` (non commité) sur le serveur de production.
# Ces valeurs sont utilisées par docker-compose.yml (Postgres + build du frontend).
# Le backend Laravel a son propre fichier séparé : backend/.env.production
# (voir backend/.env.example pour la liste complète des variables Laravel).

DB_DATABASE=sgpge
DB_USERNAME=sgpge_user
DB_PASSWORD=change_me_strong_password

NEXT_PUBLIC_API_URL=https://testsigmae.louba-maeiage.com/api
